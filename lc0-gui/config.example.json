{
  "engine": {
    "distro": "Ubuntu",
    "image": "nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04",
    "hostMount": "/home/YOUR_USER/lc0-deploy",
    "containerName": "lc0-uci",
    "binary": "/work/bin/lc0",
    "weightsDir": "/work/weights",
    "weightsFile": "network.pb.gz",
    "backend": "cuda-fp16",
    "port": 8642
  },
  "bridge": {
    "engineUrl": "ws://127.0.0.1:8642",
    "portFile": "",
    "movetimeMs": 3000,
    "threads": 2,
    "pollMs": 400,
    "clickGapMs": 120,
    "verifyTimeoutMs": 6000,
    "promoWaitMs": 2000,
    "engineWatchdogMs": 45000,
    "clockSafetyMs": 1200,
    "minMoveTimeMs": 200,
    "moveAttempts": 3,
    "retryGapMs": 400,
    "debugPort": 0,
    "daemonCli": "chrome-auto-connect-win",
    "autoStart": false,
    "autoMode": "5+3",
    "aiLevel": 8,
    "aiColor": "random",
    "aiTime": "unlimited",
    "aiPreset": "5+3",
    "nextGameDelayMs": 4000,
    "seekTimeoutMs": 120000,
    "whiteFirstMove": "d2d4",
    "stopKey": "s",
    "claimVictory": true
  }
}
